# PlayLoop — environment
#
# Copy to .env at the repository root:  cp .env.example .env
# Everything below has a working local default except AUTH_SECRET, which you
# should always set (any long random string is fine locally).

# ---------------------------------------------------------------- required
# NextAuth signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Public origins. The app builds absolute artifact URLs from these, so they must
# be reachable from the browser that plays the games.
APP_ORIGIN=http://localhost:3000
PLAY_ORIGIN=http://localhost:3001
NEXT_PUBLIC_PLAY_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------- database
# Dev: the embedded PGlite server started by `pnpm dev` listens here.
# Production: point this at real Postgres with the pgvector extension and set
# PLAYLOOP_DB=external so `pnpm start` does not start the embedded one.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DB_PORT=5432
# PLAYLOOP_DB=external

# ---------------------------------------------------------------- AI (optional)
# Any OpenAI-compatible /chat/completions endpoint. Without these the studio
# falls back to the offline template provider and the feed still works.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embeddings for recommendations (optional; games publish without them).
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=embeddinggemma

# ---------------------------------------------------------------- tuning
# Where generated artifacts and uploaded concept images live.
# ARTIFACTS_DIR=apps/play-worker/artifacts
# Set to 0 to skip the headless-browser runtime gate (faster, less safe).
# PLAYLOOP_SMOKE=0

# ---------------------------------------------------------------- hardening
# 1 = the database is PGlite behind a single socket (dev default): the app keeps
# exactly one connection. Leave 0 for a real Postgres so it gets a pool
# (`pnpm dev` and `pnpm start` set this for you).
# PLAYLOOP_SINGLE_SOCKET=0
# DATABASE_POOL_MAX=20
# Shared secret required by the artifact worker's /internal/smoke endpoint
# (it only accepts loopback callers, and only this token when set).
# PLAYLOOP_INTERNAL_TOKEN=
# Interface the artifact worker listens on (loopback by default).
# HOST=127.0.0.1
# Reject scores outside this magnitude (one client could otherwise own the board).
# LEADERBOARD_MAX_SCORE=1000000
# How far back the stats rollup recomputes on each scheduled run.
# ROLLUP_WINDOW_HOURS=6

# ---------------------------------------------------------------- E2E harness
# Credentials `scripts/e2e-studio.mjs` signs in with (a new handle is created on
# first run).
# E2E_HANDLE=saptarshi
# E2E_PASSWORD=
