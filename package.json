{
  "name": "playloop",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "node scripts/prebuild.mjs && pnpm --filter @playloop/web build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:seed-games": "tsx scripts/publish-seeds.ts",
    "gen:seed": "tsx packages/ai/seed-game.ts",
    "smoke:load": "node scripts/load-smoke.mjs",
    "e2e:studio": "node scripts/e2e-studio.mjs",
    "audit:games": "tsx scripts/audit-artifacts.ts --runtime",
    "start": "node scripts/start.mjs",
    "start:db": "tsx scripts/dev-db.ts",
    "probe:input": "tsx scripts/probe-input-matrix.ts",
    "probe:live": "tsx scripts/probe-live-input.ts",
    "stop": "node scripts/stop.mjs",
    "bench:runtimes": "tsx scripts/bench-runtimes.ts",
    "install:runtime": "node scripts/install-runtime.mjs",
    "probe:playtest": "tsx scripts/probe-playtest.ts",
    "probe:visual": "tsx scripts/probe-visual.ts",
    "ingest:assets": "tsx scripts/ingest-assets.ts"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.36.0",
    "@babylonjs/loaders": "9.36.0",
    "@electric-sql/pglite-socket": "^0.2.18",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "phaser": "4.2.1",
    "tsx": "^4.23.15",
    "turbo": "^2",
    "typescript": "^5"
  },
  "dependencies": {
    "@playloop/assets": "workspace:*"
  }
}
